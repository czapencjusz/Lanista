{
  "manifest_version": 3,
  "name": "Lanista - Gladiatus Autopilot",
  "short_name": "Lanista",
  "version": "2.0.0",
  "description": "Automates Gladiatus: expeditions, dungeons, Underworld, arena, circus, healing, quests, work, repair, smelting, packages, auctions.",
  "minimum_chrome_version": "121",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "storage",
    "alarms",
    "notifications"
  ],
  "host_permissions": [
    "https://*.gladiatus.gameforge.com/*"
  ],
  "background": {
    "service_worker": "src/background/background.js",
    "scripts": [
      "src/shared/settings.js",
      "src/shared/tier.js",
      "src/background/background.js"
    ]
  },
  "action": {
    "default_title": "Lanista",
    "default_popup": "src/pages/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "options_ui": {
    "page": "src/pages/options.html",
    "open_in_tab": true
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.gladiatus.gameforge.com/game/*"
      ],
      "js": [
        "src/shared/settings.js",
        "src/shared/tier.js",
        "src/content/util.js",
        "src/content/selectors.js",
        "src/content/state.js",
        "src/content/brain.js",
        "src/content/actions.js",
        "src/content/workbench.js",
        "src/content/smelter.js",
        "src/content/packages.js",
        "src/content/auction.js",
        "src/ui/dom.js",
        "src/ui/styles.js",
        "src/ui/schema.js",
        "src/ui/settings-ui.js",
        "src/content/panel.js",
        "src/content/main.js"
      ],
      "run_at": "document_end"
    }
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "gbot@gladiatus-autopilot",
      "strict_min_version": "121.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    }
  }
}
